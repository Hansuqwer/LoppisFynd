# Never commit real secrets. Copy to `.env` for local dev.

# Tradera (to be used server-side via Supabase Edge Functions)
TRADERA_APP_ID=
TRADERA_APP_KEY=
TRADERA_PUBLIC_KEY=

# Supabase (paste anon key in local `.env`)
SUPABASE_URL=https://wtiesnxyjytdfvgnnpep.supabase.co
SUPABASE_ANON_KEY=

# Edge function endpoint used by the app
TRADERA_PROXY_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/tradera-proxy

# Google Books API (for ISBN metadata lookup)
GOOGLE_BOOKS_API_KEY=

# Apify (for Vinted scraping)
APIFY_API_TOKEN=
VINTED_SCRAPER_ACTOR_ID=

# Bokbörsen scraper edge function URL
BOKBORSEN_SCRAPER_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/bokborsen-scraper

# Adlibris scraper edge function URL (optional - adds used-book asking prices)
ADLIBRIS_SCRAPER_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/adlibris-scraper

# Blocket scraper edge function URL (optional - adds active asking-price comps)
BLOCKET_SCRAPER_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/blocket-scraper

# Book market aggregator edge function URL
BOOK_MARKET_AGGREGATOR_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/book-market-aggregator

# Optional server-side source URLs for book-market-aggregator
ADLIBRIS_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/adlibris-scraper
BLOCKET_URL=https://wtiesnxyjytdfvgnnpep.supabase.co/functions/v1/blocket-scraper

